let runSeed=0;const T={a:0,b:0,c:0,d:0,e:0,f:0};
function reseed(){runSeed=rand(1000);T.a=rand(TAU);T.b=rand(TAU);T.c=rand(TAU);T.d=rand(TAU);T.e=rand(TAU);T.f=rand(TAU);}
function hash(n){const s=Math.sin(n*127.1+runSeed*311.7)*43758.5453;return s-Math.floor(s);}
function groundY(x){
  let t=clamp(x/900,0,1);t=t*t*(3-2*t);
  const m1=0.7+0.3*Math.sin(x*0.00023+T.e);
  const m2=0.5+0.5*Math.sin(x*0.00017+T.f);
  return x*0.085+t*(m1*(72*Math.sin(x*0.0016+T.a)+40*Math.sin(x*0.0009+T.b))
                   +m2*(46*Math.sin(x*0.0072+T.c)+18*Math.sin(x*0.0031+T.d)));
}
function slopeAt(x){return(groundY(x+3)-groundY(x-3))/6;}

