<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0B1430">
<title>Новогодний спуск — Дед Мороз на лыжах</title>
<style>
  :root{
    --navy:#0B1430; --panel:rgba(11,21,46,.62); --line:rgba(255,255,255,.14);
    --ice:#BFE0FF; --txt:#EAF2FF; --mut:#9FB6D8;
    --red:#E23B3B; --red2:#C22525; --gold:#FFD75E; --teal:#59D6C9;
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;overflow:hidden}
  body{
    position:fixed; inset:0; background:var(--navy); color:var(--txt);
    font-family:"Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif;
    user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;
  }
  ::selection{background:var(--red);color:#fff}
  *{scrollbar-width:thin;scrollbar-color:var(--red) rgba(10,18,40,.6)}
  ::-webkit-scrollbar{width:10px;height:10px}
  ::-webkit-scrollbar-track{background:rgba(10,18,40,.6)}
  ::-webkit-scrollbar-thumb{background:linear-gradient(180deg,var(--red),var(--red2));border-radius:8px;border:2px solid rgba(10,18,40,.6)}
  ::-webkit-scrollbar-thumb:hover{background:#F05A5A}

  #c{position:fixed;inset:0;display:block;touch-action:none;cursor:pointer}

  .hidden{display:none !important}

  /* ---------- HUD ---------- */
  #hud{position:fixed;top:14px;left:14px;pointer-events:none;z-index:5}
  .hud-card{
    background:var(--panel);border:1px solid var(--line);border-radius:16px;
    padding:10px 16px 12px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
    box-shadow:0 8px 30px rgba(4,10,26,.35);
  }
  .hud-label{font-size:10px;letter-spacing:.22em;color:var(--mut);font-weight:700}
  .hud-dist{font-size:clamp(26px,5vw,42px);font-weight:900;line-height:1.05;font-variant-numeric:tabular-nums;text-shadow:0 2px 12px rgba(4,10,26,.5)}
  .hud-dist .unit{font-size:.45em;font-weight:700;color:var(--ice);margin-left:6px}
  .hud-row{display:flex;gap:8px;margin-top:6px}
  .chip{
    display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.08);
    border:1px solid var(--line);border-radius:999px;padding:3px 11px;
    font-size:12px;font-weight:700;letter-spacing:.06em;color:var(--ice);font-variant-numeric:tabular-nums;
  }
  .chip b{color:#fff;font-weight:800}
  .chip.gold{color:var(--gold)} .chip.gold b{color:var(--gold)}
  #speedo{position:fixed;left:16px;bottom:14px;z-index:5;pointer-events:none;
    background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:5px 14px;
    font-size:12px;font-weight:700;color:var(--mut);letter-spacing:.08em;font-variant-numeric:tabular-nums;
    backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
  #speedo b{color:var(--txt)}

  /* ---------- Top bar ---------- */
  #topbar{position:fixed;top:14px;right:14px;z-index:20;display:flex;gap:8px;align-items:center}
  #topbar .chip{background:var(--panel);padding:8px 14px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
  .iconbtn{
    width:44px;height:44px;border-radius:14px;border:1px solid var(--line);
    background:var(--panel);color:var(--txt);cursor:pointer;display:flex;align-items:center;justify-content:center;
    backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);transition:transform .15s,background .15s,border-color .15s;
  }
  .iconbtn:hover{transform:translateY(-2px);background:rgba(30,48,92,.75);border-color:rgba(255,255,255,.3)}
  .iconbtn:active{transform:scale(.94)}
  .iconbtn svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  #btnSound .off{display:none}
  #btnSound.muted .on{display:none}
  #btnSound.muted .off{display:block}
  #btnSound.muted{color:#FF8A8A}
  button:focus-visible{outline:3px solid var(--gold);outline-offset:2px}

  /* ---------- Overlays ---------- */
  .overlay{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;
    padding:20px;overflow-y:auto;animation:fadeIn .35s both}
  #ovMenu{background:linear-gradient(180deg,rgba(6,12,30,.66),rgba(6,12,30,.18) 46%,rgba(6,12,30,.7))}
  #ovOver{background:radial-gradient(ellipse at 50% 40%,rgba(8,14,34,.5),rgba(6,11,28,.82));z-index:12}
  #ovPause{background:rgba(6,11,28,.62);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);z-index:12}
  @keyframes fadeIn{from{opacity:0}to{opacity:1}}
  @keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
  @keyframes shimmer{0%,100%{box-shadow:0 0 14px rgba(255,215,94,.35)}50%{box-shadow:0 0 30px rgba(255,215,94,.8)}}
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}

  .menu-inner{max-width:640px;width:100%;text-align:center;margin:auto}
  .menu-inner>*{animation:fadeUp .6s both}
  .menu-inner>*:nth-child(2){animation-delay:.08s}.menu-inner>*:nth-child(3){animation-delay:.16s}
  .menu-inner>*:nth-child(4){animation-delay:.24s}.menu-inner>*:nth-child(5){animation-delay:.32s}
  .menu-inner>*:nth-child(6){animation-delay:.4s}
  .kicker{font-size:12px;font-weight:800;letter-spacing:.34em;color:var(--ice);margin-bottom:12px}
  h1{
    font-size:clamp(42px,9vw,92px);font-weight:900;line-height:.95;letter-spacing:.01em;
    background:linear-gradient(180deg,#FFFFFF 20%,#BFE0FF 75%,#8FBCEC);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 6px 24px rgba(4,10,26,.6));margin-bottom:14px;
  }
  .tag{color:var(--mut);font-size:clamp(13px,2vw,16px);max-width:460px;margin:0 auto 22px;line-height:1.5}
  .tag b{color:var(--txt)}

  .diff{display:flex;gap:8px;justify-content:center;margin-bottom:20px;flex-wrap:wrap}
  .pill{
    border:1px solid var(--line);background:rgba(255,255,255,.07);color:var(--ice);
    border-radius:999px;padding:9px 20px;font-size:13px;font-weight:800;letter-spacing:.08em;cursor:pointer;
    transition:all .18s;font-family:inherit;
  }
  .pill:hover{background:rgba(255,255,255,.14);transform:translateY(-2px)}
  .pill.sel{background:linear-gradient(180deg,#F05A5A,var(--red2));color:#fff;border-color:rgba(255,255,255,.35);
    box-shadow:0 6px 20px rgba(226,59,59,.4)}

  .btn{
    font-family:inherit;border:none;cursor:pointer;border-radius:999px;font-weight:900;letter-spacing:.1em;
    transition:transform .16s,box-shadow .16s,background .16s;
  }
  .btn.primary{
    background:linear-gradient(180deg,#F25757,var(--red2));color:#fff;font-size:18px;padding:17px 52px;
    box-shadow:0 10px 34px rgba(226,59,59,.45),inset 0 1px 0 rgba(255,255,255,.35);
    animation:bob 3.2s ease-in-out infinite;
  }
  .btn.primary:hover{transform:translateY(-3px) scale(1.03);box-shadow:0 16px 44px rgba(226,59,59,.6),inset 0 1px 0 rgba(255,255,255,.35)}
  .btn.primary:active{transform:scale(.96)}
  .btn.ghost{
    background:rgba(255,255,255,.08);border:1px solid var(--line);color:var(--txt);
    font-size:14px;padding:13px 30px;
  }
  .btn.ghost:hover{background:rgba(255,255,255,.16);transform:translateY(-2px)}

  .legend{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:26px auto 0;max-width:560px;text-align:left}
  .legend .li{
    background:rgba(11,21,46,.55);border:1px solid var(--line);border-radius:12px;padding:9px 13px;
    font-size:12.5px;color:var(--mut);display:flex;align-items:center;gap:8px;flex-wrap:wrap;
    backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  }
  kbd{
    background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);border-bottom-width:3px;
    border-radius:6px;padding:2px 8px;font-family:inherit;font-size:11px;font-weight:800;color:#fff;white-space:nowrap;
  }
  .hint{margin-top:18px;font-size:11px;letter-spacing:.14em;color:rgba(159,182,216,.7);font-weight:700}
  .touch-only{display:none}
  @media (pointer:coarse){.touch-only{display:flex}.keys-only{display:none !important}}
  @media (max-width:560px){.legend{grid-template-columns:1fr}}

  /* ---------- Panels ---------- */
  .panel{
    width:min(92vw,470px);background:var(--panel);border:1px solid var(--line);border-radius:22px;
    padding:30px 30px 26px;text-align:center;margin:auto;
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    box-shadow:0 24px 80px rgba(3,8,22,.7);animation:fadeUp .45s both;
  }
  .panel h2{font-size:clamp(26px,5vw,36px);font-weight:900;letter-spacing:.04em;margin-bottom:6px}
  #ovOver h2{color:#FF7B7B;text-shadow:0 0 30px rgba(226,59,59,.4)}
  .cause{color:var(--mut);font-size:14px;margin-bottom:4px}
  .flavor{color:rgba(159,182,216,.65);font-size:12px;margin-bottom:18px}
  #goRecord{
    display:inline-block;background:linear-gradient(90deg,#FFD75E,#FFB347);color:#4A2E00;
    font-weight:900;font-size:13px;letter-spacing:.14em;border-radius:999px;padding:7px 20px;margin-bottom:16px;
    animation:shimmer 1.6s infinite;
  }
  .stats{margin:6px 0 20px;text-align:left}
  .srow{display:flex;justify-content:space-between;align-items:baseline;padding:9px 4px;border-bottom:1px dashed rgba(255,255,255,.12);font-size:14px;color:var(--mut)}
  .srow b{color:var(--txt);font-weight:800;font-variant-numeric:tabular-nums}
  .srow .plus{color:var(--gold);font-size:12px;margin-left:6px;font-weight:700}
  .srow.total{border-bottom:none;margin-top:4px;font-size:16px;color:var(--ice);font-weight:800}
  .srow.total b{font-size:30px;color:var(--gold);text-shadow:0 0 20px rgba(255,215,94,.35)}
  .btnrow{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
  .panel .btn.primary{font-size:15px;padding:15px 36px;animation:none}
  .panel .hint{margin-top:16px}
</style>
</head>
<body>
<canvas id="c"></canvas>

<div id="hud" class="hidden">
  <div class="hud-card">
    <div class="hud-label">ДИСТАНЦИЯ</div>
    <div class="hud-dist"><span id="hDist">0</span><span class="unit">м</span></div>
    <div class="hud-row">
      <span class="chip gold">★ <b id="hStars">0</b></span>
      <span class="chip">СЧЁТ <b id="hScore">0</b></span>
    </div>
  </div>
</div>
<div id="speedo" class="hidden"><b id="kmh">0</b> км/ч</div>

<div id="topbar">
  <span class="chip">РЕКОРД <b id="bestVal">0</b></span>
  <button id="btnPause" class="iconbtn hidden" aria-label="Пауза" title="Пауза (P)">
    <svg viewBox="0 0 24 24"><line x1="9" y1="5" x2="9" y2="19"/><line x1="15" y1="5" x2="15" y2="19"/></svg>
  </button>
  <button id="btnSound" class="iconbtn" aria-label="Звук вкл/выкл" title="Звук (M)">
    <svg class="on" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 9a4 4 0 0 1 0 6"/><path d="M18.5 6.5a8 8 0 0 1 0 11"/></svg>
    <svg class="off" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4z"/><line x1="16" y1="9" x2="21" y2="15"/><line x1="21" y1="9" x2="16" y2="15"/></svg>
  </button>
</div>

<div id="ovMenu" class="overlay">
  <div class="menu-inner">
    <div class="kicker">ДЕД МОРОЗ · БЕСКОНЕЧНЫЙ РАННЕР</div>
    <h1>НОВОГОДНИЙ<br>СПУСК</h1>
    <p class="tag">Мешок подарков за спиной, лыжи на снегу и горы до горизонта.
      Прыгай через <b>камни, сугробы и замёрзшие ели</b>, собирай звёзды и шары, крути сальто — Новый год ждёт!</p>
    <div class="diff" id="diffRow">
      <button class="pill" data-d="0">ПРОГУЛКА</button>
      <button class="pill sel" data-d="1">КЛАССИКА</button>
      <button class="pill" data-d="2">БУРАН</button>
    </div>
    <div><button id="btnStart" class="btn primary">В ПУТЬ!</button></div>
    <div class="legend">
      <div class="li keys-only"><kbd>Пробел</kbd><kbd>Клик</kbd> — прыжок</div>
      <div class="li keys-only"><kbd>↓</kbd><kbd>Удержание</kbd> — присед / стабилизация</div>
      <div class="li keys-only"><kbd>Пробел ×2</kbd> в воздухе — сальто</div>
      <div class="li keys-only"><kbd>P</kbd> пауза · <kbd>M</kbd> звук · <kbd>R</kbd> заново</div>
      <div class="li touch-only">Тап — прыжок · удержание — присед</div>
      <div class="li touch-only">Тапы в воздухе — сальто · удержание — приземление</div>
    </div>
    <div class="hint">ЛУЧШИЙ РЕЗУЛЬТАТ: <span id="menuBest">0</span></div>
  </div>
</div>

<div id="ovOver" class="overlay hidden">
  <div class="panel">
    <h2>ИГРА ОКОНЧАНА</h2>
    <div class="cause" id="goCause">Вы врезались в камень</div>
    <div class="flavor">Мешок рассыпался, но Новый год не отменяется!</div>
    <div id="goRecord" class="hidden">★ НОВЫЙ РЕКОРД! ★</div>
    <div class="stats">
      <div class="srow"><span>Дистанция</span><b id="goDist">0 м</b></div>
      <div class="srow"><span>Бонусы ★</span><span><b id="goBonus">0</b><span class="plus" id="goBonusPts">+0</span></span></div>
      <div class="srow"><span>Трюки</span><span><b id="goTrick">0</b><span class="plus" id="goTrickPts">+0</span></span></div>
      <div class="srow total"><span>ИТОГО</span><b id="goTotal">0</b></div>
    </div>
    <div class="btnrow">
      <button id="btnRetry" class="btn primary">Начать заново</button>
      <button id="btnToMenu" class="btn ghost">В меню</button>
    </div>
    <div class="hint">ПРОБЕЛ — ЗАНОВО</div>
  </div>
</div>

<div id="ovPause" class="overlay hidden">
  <div class="panel">
    <h2>ПАУЗА</h2>
    <div class="flavor">Снежинки подождут.</div>
    <div class="btnrow">
      <button id="btnResume" class="btn primary">Продолжить</button>
      <button id="btnPauseRetry" class="btn ghost">Заново</button>
      <button id="btnPauseMenu" class="btn ghost">В меню</button>
    </div>
    <div class="hint">P / ПРОБЕЛ — ПРОДОЛЖИТЬ</div>
  </div>
</div>

<script>
(function(){
'use strict';
/* ============================== HELPERS ============================== */
const TAU=Math.PI*2;
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
const lerp=(a,b,t)=>a+(b-a)*t;
const rand=(a,b)=>b===undefined?Math.random()*a:a+Math.random()*(b-a);
const fmt=n=>Math.floor(n).toLocaleString('ru-RU');
const wrapAngle=a=>{a=(a+Math.PI)%TAU;if(a<0)a+=TAU;return a-Math.PI;};
const easeOutBack=t=>{const c=1.70158;t-=1;return 1+(c+1)*t*t*t+c*t*t;};
const mix3=(a,b,t)=>[lerp(a[0],b[0],t),lerp(a[1],b[1],t),lerp(a[2],b[2],t)];
const css=c=>'rgb('+(c[0]|0)+','+(c[1]|0)+','+(c[2]|0)+')';
const $=id=>document.getElementById(id);
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;

function load(k,d){try{const v=localStorage.getItem(k);return v===null?d:JSON.parse(v);}catch(e){return d;}}
function save(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}

/* ============================== CANVAS ============================== */
const cv=$('c'),ctx=cv.getContext('2d');
let W=0,H=0,DPR=1,S=1,VW=0,VH=0;
function resize(){
  DPR=Math.min(window.devicePixelRatio||1,2);
  W=window.innerWidth;H=window.innerHeight;
  cv.width=Math.round(W*DPR);cv.height=Math.round(H*DPR);
  cv.style.width=W+'px';cv.style.height=H+'px';
  S=Math.min(H/540,W/780);VW=W/S;VH=H/S;
}
window.addEventListener('resize',resize);resize();

function rr(g,x,y,w,h,r){
  r=Math.min(r,w/2,h/2);
  g.beginPath();
  g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);
  g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();
}
function starPath(g,R,r){
  g.beginPath();
  for(let i=0;i<10;i++){
    const a=-Math.PI/2+i*Math.PI/5,rad=i%2===0?R:r;
    const x=Math.cos(a)*rad,y=Math.sin(a)*rad;
    i===0?g.moveTo(x,y):g.lineTo(x,y);
  }
  g.closePath();
}

/* ============================== SPRITES ============================== */
function makeRadial(size,stops){
  const c=document.createElement('canvas');c.width=c.height=size;
  const g=c.getContext('2d');
  const gr=g.createRadialGradient(size/2,size/2,1,size/2,size/2,size/2);
  for(const s of stops)gr.addColorStop(s[0],s[1]);
  g.fillStyle=gr;g.fillRect(0,0,size,size);return c;
}
const shadowSpr=makeRadial(96,[[0,'rgba(8,14,34,0.55)'],[1,'rgba(8,14,34,0)']]);
const glowWarm=makeRadial(160,[[0,'rgba(255,236,180,0.5)'],[1,'rgba(255,236,180,0)']]);
const glowCool=makeRadial(160,[[0,'rgba(214,232,255,0.4)'],[1,'rgba(214,232,255,0)']]);
const starSpr=(function(){
  const c=document.createElement('canvas');c.width=c.height=76;
  const g=c.getContext('2d');
  const gr=g.createRadialGradient(38,38,2,38,38,37);
  gr.addColorStop(0,'rgba(255,214,90,0.55)');gr.addColorStop(1,'rgba(255,214,90,0)');
  g.fillStyle=gr;g.fillRect(0,0,76,76);
  g.translate(38,38);starPath(g,15,6.4);
  g.fillStyle='#FFD75E';g.fill();
  g.strokeStyle='rgba(255,246,214,0.95)';g.lineWidth=2.4;g.lineJoin='round';g.stroke();
  return c;
})();

/* ============================== PALETTES ============================== */
const KEYS=[
 {skyT:[86,140,208],skyB:[201,228,247],far:[143,180,224],mid:[108,150,205],hill:[166,199,232],trees:[74,116,160],
  snow:[242,248,253],snowD:[214,232,246],line:[255,255,255],fog:[201,228,247],cloud:[255,255,255],night:0},
 {skyT:[76,84,158],skyB:[244,186,150],far:[124,116,182],mid:[95,92,160],hill:[150,140,196],trees:[70,70,124],
  snow:[246,235,232],snowD:[223,208,220],line:[255,244,238],fog:[238,196,170],cloud:[255,224,204],night:0.15},
 {skyT:[10,17,44],skyB:[40,62,118],far:[36,52,96],mid:[27,41,80],hill:[48,66,110],trees:[22,34,64],
  snow:[214,228,246],snowD:[182,202,230],line:[236,246,255],fog:[46,68,122],cloud:[180,200,235],night:1},
 {skyT:[62,110,168],skyB:[247,214,190],far:[110,140,190],mid:[86,116,170],hill:[140,168,208],trees:[58,92,138],
  snow:[240,242,248],snowD:[214,224,240],line:[255,250,244],fog:[232,210,196],cloud:[255,236,220],night:0.1}
];
const C={};
function updatePalette(m){
  const ph=(m/620)%4,i=Math.floor(ph);
  let f=ph-i;f=f*f*(3-2*f);
  const A=KEYS[i],B=KEYS[(i+1)%4];
  const white=[255,255,255];
  for(const k of ['skyT','skyB','far','mid','hill','trees','snow','snowD','line','fog','cloud'])
    C[k]=css(mix3(A[k],B[k],f));
  const night=C.night=lerp(A.night,B.night,f);
  const mid=mix3(A.mid,B.mid,f),trees=mix3(A.trees,B.trees,f),snowD=mix3(A.snowD,B.snowD,f),snow=mix3(A.snow,B.snow,f);
  C.farCap=css(mix3(mix3(A.far,B.far,f),white,0.45));
  C.midCap=css(mix3(mid,white,0.4));
  const rock=mix3(mid,[26,34,54],0.42);
  C.rock=css(rock);C.rockL=css(mix3(rock,white,0.16));
  C.ice=css(mix3([124,205,222],[40,70,110],night*0.55));
  C.iceL=css(mix3(mix3([124,205,222],[40,70,110],night*0.55),white,0.5));
