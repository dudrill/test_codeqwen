function drawRidge(pf,w,hMin,hMax,col,cap,baseY,seedK){
  const ox=cam.x*pf,i0=Math.floor(ox/w)-1,n=Math.ceil(VW/w)+3;
  const v=i=>hash(i*3.1+seedK)*26;
  const h=i=>hMin+hash(i*7.3+seedK)*(hMax-hMin);
  ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(-60,VH+60);
  for(let i=i0;i<i0+n;i++){const x0=i*w-ox;
    ctx.lineTo(x0,baseY-v(i));ctx.lineTo(x0+w*0.5,baseY-h(i));}
  ctx.lineTo((i0+n)*w-ox,baseY-v(i0+n));
  ctx.lineTo(VW+60,VH+60);ctx.closePath();ctx.fill();
  ctx.fillStyle=cap;
  for(let i=i0;i<i0+n;i++){
    const x0=i*w-ox,ax=x0+w*0.5,ay=baseY-h(i),ct=0.3;
    ctx.beginPath();ctx.moveTo(ax,ay);
    ctx.lineTo(ax+(x0-ax)*ct,ay+(baseY-v(i)-ay)*ct);
    ctx.lineTo(ax+(x0+w-ax)*ct,ay+(baseY-v(i+1)-ay)*ct);
    ctx.closePath();ctx.fill();
  }
}
function hillY(wx,base){return base-(26*Math.sin(wx*0.004+T.b)+16*Math.sin(wx*0.0093+T.d));}
function drawFir(x,y,h,col,cap){
  if(h>50){ctx.fillStyle=C.trunk;ctx.fillRect(x-h*0.045,y-h*0.16,h*0.09,h*0.16);}
  ctx.fillStyle=col;
  for(let t=0;t<3;t++){
    const w=h*(0.62-0.14*t),ty=y-h*(0.14+0.26*t),th=h*0.36;
    ctx.beginPath();ctx.moveTo(x-w/2,ty);ctx.lineTo(x,ty-th);ctx.lineTo(x+w/2,ty);ctx.closePath();ctx.fill();
    if(cap){ctx.strokeStyle=cap;ctx.lineWidth=Math.max(1.5,h*0.03);ctx.lineCap='round';
      ctx.beginPath();ctx.moveTo(x-w/2,ty);ctx.lineTo(x,ty-th);ctx.stroke();}
  }
}
function drawHills(dev){
  const pf=0.45,ox=cam.x*pf,base=VH*0.68-dev*0.18;
  ctx.fillStyle=C.hill;ctx.beginPath();ctx.moveTo(-30,VH+60);
  for(let sx=-30;sx<=VW+30;sx+=24)ctx.lineTo(sx,hillY(sx+ox,base));
  ctx.lineTo(VW+30,VH+60);ctx.closePath();ctx.fill();
  const j0=Math.floor(ox/88)-1,n=Math.ceil(VW/88)+3;
  for(let j=j0;j<j0+n;j++){
    if(hash(j*1.7+9)<0.42)continue;
    const x=j*88-ox+hash(j*2.3+4)*40,h=20+hash(j*3.7+11)*26;
    drawFir(x,hillY(x+ox,base)+2,h,C.trees,null);
  }
  const fg=ctx.createLinearGradient(0,base-130,0,base+30);
  fg.addColorStop(0,'rgba(0,0,0,0)');
  const fogC=C.fog;
  fg.addColorStop(1,fogC.replace('rgb','rgba').replace(')',',0.4)'));
  ctx.fillStyle=fg;ctx.fillRect(0,base-130,VW,160);
}
function drawTerrain(){
  const x0=cam.x-30,x1=cam.x+VW+30;
  const g=ctx.createLinearGradient(0,cam.y+VH*0.3,0,cam.y+VH);
  g.addColorStop(0,C.snow);g.addColorStop(1,C.snowD);
  ctx.fillStyle=g;ctx.beginPath();ctx.moveTo(x0,cam.y+VH+80);
