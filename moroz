/* ============================== PLAYER PHYSICS ============================== */
function startAir(){P.air=0;P.airRot=0;P.flips=0;P.om=0;}
function doJump(){
  if(P.on){
    const s=slopeAt(P.x),inv=1/Math.hypot(1,s);
    P.vx=P.v*inv;P.vy=P.v*s*inv;P.on=false;startAir();
  }
  P.vy-=JUMP*(1+0.12*P.crouch);
  if(P.vy<-920)P.vy=-920;
  P.jbuf=0;P.coyote=0;P.sqv-=3;
  sfx.jump();puffAt(P.x-6,P.y,5);
}
function spin(){
  if(P.on||state!=='playing')return;
  P.om=Math.max(-13,P.om-6.8);P.spinT=0.25;sfx.spin();
}
function flipName(n){
  return n===1?'САЛЬТО':n===2?'ДВОЙНОЕ САЛЬТО':n===3?'ТРОЙНОЕ САЛЬТО':'САЛЬТО ×'+n;
}
function land(gy,th){
  const diff=Math.abs(wrapAngle(P.rot-th));
  if(diff>1.45&&state==='playing'){crash('landing');return;}
  const s=slopeAt(P.x),inv=1/Math.hypot(1,s);
  const impact=Math.max(0,P.vy-s*P.vx);
  P.on=true;P.y=gy;P.rot=th;
  P.v=clamp((P.vx*inv+P.vy*s*inv)*(diff>0.8?0.75:0.985),speedFloor()*0.8,DIFF.max);
  P.om=0;P.sqv+=clamp(impact*0.006,1.2,6);
  sprayBurst(P.x,P.y,clamp(impact/40,4,22)|0,impact);
  shake(clamp(impact/900,0,1)*5);sfx.land(impact);
  if(state==='playing'){
    if(P.flips>0){
      const n=P.flips,pts=500*n+100*n*(n-1);
      trickPts+=pts;trickCount+=n;
      popupScreen(flipName(n)+'!  +'+pts,'#FFD75E',32);sfx.trick();
      sparkBurst(P.x,P.y-30,'#FFD75E',10);
    }else if(P.air>0.55&&diff<0.22&&impact>250){
      trickPts+=150;popupScreen('ИДЕАЛЬНО! +150','#BFF5FF',26);sfx.perfect();
    }
  }
  P.air=0;P.airRot=0;P.flips=0;
}
function crash(kind){
  if(state!=='playing')return;
  state='crashing';crashT=0;goShown=false;
  causeText=kind==='rock'?'Вы врезались в камень':kind==='drift'?'Вы врезались в сугроб':
            kind==='tree'?'Вы врезались в замёрзшую ель':'Неудачное приземление';
  finalStats={m:Math.floor(meters),stars:starCount,bp:bonusPts,tp:trickPts,tc:trickCount};
  P.on=false;P.deflated=true;
  P.vx*=0.55;P.vy=-320;P.om=(Math.random()<0.5?-1:1)*rand(7,11);
  const c=Math.cos(P.rot),s=Math.sin(P.rot);
  burstGifts(P.x+(-20)*c-(-40)*s,P.y+(-20)*s+(-40)*c);
  sprayBurst(P.x,P.y,26,600);
  shake(16);flash=1;sfx.crash();
}
function stepPlayer(dt,crouchIn){
  const cT=(crouchIn&&P.on)?1:0;
  P.crouch+=(cT-P.crouch)*Math.min(1,dt*10);
  P.sqv+=(-160*P.sq-14*P.sqv)*dt;P.sq=clamp(P.sq+P.sqv*dt,-0.3,0.45);
  if(P.on){
    const s=slopeAt(P.x),inv=1/Math.hypot(1,s),cs=inv,sn=s*inv;
    const drag=P.crouch>0.5?0.05:0.11;
    let a=G*sn+(P.crouch>0.5?110:70)-P.v*drag;
    P.v=clamp(P.v+a*dt,speedFloor(),state==='menu'?700:DIFF.max);
    const oldVy=P.v*sn;
    P.x+=P.v*cs*dt;
    const gy=groundY(P.x),drop=gy-P.y;
    const free=oldVy*dt+0.5*G*0.82*dt*dt;
    if(drop>free+0.9){
      P.on=false;P.vx=P.v*cs;P.vy=oldVy;startAir();P.coyote=0.09;
    }else{
      P.y=gy;P.coyote=0.09;
      P.rot+=wrapAngle(Math.atan(s)-P.rot)*Math.min(1,dt*14);
      if(P.jbuf>0)doJump();
      if(P.on){
        P.spray+=dt*(P.v/55)*(0.6+P.crouch*0.8);
        while(P.spray>1){P.spray--;
          addP({type:'spray',x:P.x-18+rand(-6,4),y:P.y-1,vx:-P.v*0.25+rand(-40,40),
            vy:rand(-150,-30),t:0,life:rand(0.3,0.6),size:rand(1.4,3.2)});}
        const last=track[track.length-1];
        if(!last||P.x-last.x>12){track.push({x:P.x,y:P.y});if(track.length>140)track.shift();}
        P.breath-=dt;
        if(P.breath<0){P.breath=rand(1.3,2.2);
          const c=Math.cos(P.rot),sn2=Math.sin(P.rot);
          addP({type:'puff',x:P.x+14*c-(-52)*sn2,y:P.y+14*sn2+(-52)*c,
            vx:30,vy:-16,t:0,life:0.9,size:3});}
        if(P.v>850&&Math.random()<dt*14)
          addP({type:'streak',x:P.x+rand(-60,300),y:P.y-rand(10,110),vx:-P.v*1.4,t:0,life:0.22,size:rand(20,50)});
      }
    }
  }else{
    P.air+=dt;
    const stab=crouchIn||state==='menu';
    P.vy+=G*(stab?1.35:1)*dt;
    P.vx*=(1-0.02*dt);
    P.x+=P.vx*dt;P.y+=P.vy*dt;
    P.rot+=P.om*dt;P.airRot+=P.om*dt;
    const f=Math.floor((Math.abs(P.airRot)+0.4)/TAU);
    if(f>P.flips){P.flips=f;
      if(state==='playing'){popupScreen(flipName(f)+'!','#FFD75E',28);sfx.flip();
        addP({type:'ring',x:P.x,y:P.y-28,t:0,life:0.35,size:16,c:'#FFD75E'});}}
    const gy=groundY(P.x),th=Math.atan(slopeAt(P.x)),h=gy-P.y;
    if(stab||(h<150&&P.spinT<=0)){
      P.om*=Math.exp(-(stab?7:10)*dt);
      P.rot+=wrapAngle(th-P.rot)*Math.min(1,dt*(stab?16:13)*(state==='menu'?2:1));
    }else if(Math.abs(P.om)<2.5){
      P.rot+=wrapAngle(th-P.rot)*Math.min(1,dt*3);
    }
    P.om*=Math.exp(-0.25*dt);
    if(P.coyote>0&&P.jbuf>0)doJump();
    if(P.y>=gy-0.01){
      const rel=P.vy-slopeAt(P.x)*P.vx;
      if(rel>0)land(gy,th);else P.y=gy;
    }
  }
  P.jbuf=Math.max(0,P.jbuf-dt);P.coyote=Math.max(0,P.coyote-dt);P.spinT=Math.max(0,P.spinT-dt);
}
function tumble(dt){
  P.vy+=G*dt;P.vx*=Math.exp(-0.3*dt);
  P.x+=P.vx*dt;P.y+=P.vy*dt;P.rot+=P.om*dt;
  const gy=groundY(P.x);
  if(P.y>gy){P.y=gy;
    if(P.vy>60){P.vy*=-0.38;P.vx*=0.7;P.om*=0.6;sprayBurst(P.x,P.y,6,300);sfx.thud();}
    else P.vy=0;
    P.vx*=Math.exp(-2.2*dt);P.om*=Math.exp(-2.5*dt);
    if(Math.abs(P.vx)<20){P.vx=0;P.om=0;}
  }
}

/* ============================== COLLISIONS & PICKUPS ============================== */
function playerCircles(){
  const c=Math.cos(P.rot),s=Math.sin(P.rot),cr=P.crouch;
  const by=-(18-8*cr),r=14-4*cr;
  return[{x:P.x-by*s,y:P.y+by*c,r},
         {x:P.x+16*c+4*s,y:P.y+16*s-4*c,r:8}];
}
function hitCircle(px,py,pr,cx,cy,cr){
  const dx=px-cx,dy=py-cy,rr2=pr+cr-2;
  return dx*dx+dy*dy<rr2*rr2;
}
function collisions(){
  const pcs=playerCircles();
  for(const o of obs){
    if(Math.abs(o.x-P.x)>130)continue;
    let cx,cy,cr;
    if(o.type==='rock'){cx=o.x;cy=o.gy-o.s*0.5;cr=o.s*0.72;}
    else if(o.type==='drift'){cx=o.x;cy=o.gy-9;cr=15;}
    else{cx=o.x;cy=o.gy-o.h*0.42;cr=o.h*0.30;}
    for(const pc of pcs){
      if(hitCircle(pc.x,pc.y,pc.r,cx,cy,cr)){crash(o.type);return;}
      if(o.type==='tree'&&hitCircle(pc.x,pc.y,pc.r,o.x,o.gy-8,7)){crash(o.type);return;}
    }
  }
  const bx=pcs[0].x,by=pcs[0].y;
  for(const st of stars){
    if(st.taken||Math.abs(st.x-P.x)>60)continue;
    const dx=st.x-bx,dy=st.y-by;
    if(dx*dx+dy*dy<34*34){
      st.taken=true;starCount++;bonusPts+=25;cStreak++;cTimer=2;
      sparkBurst(st.x,st.y,'#FFD75E',7);popupWorld('+25',st.x,st.y-14);sfx.star(cStreak);
    }
  }
  for(const b of balls){
    if(b.taken||Math.abs(b.x-P.x)>70)continue;
    const byy=b.y0+Math.sin(tSim*1.3+b.ph)*12;
    const dx=b.x-bx,dy=byy-by;
    if(dx*dx+dy*dy<38*38){
      b.taken=true;starCount++;bonusPts+=100;cStreak++;cTimer=2;
      balloonPop(b.x,byy,b.c);popupWorld('+100',b.x,byy-20,'#FFFFFF',17);sfx.balloon();
    }
  }
}

