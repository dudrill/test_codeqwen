    const sc=1+0.12*Math.sin(tSim*3+st.ph);
    ctx.save();ctx.translate(st.x,st.y);ctx.rotate(tSim*1.5+st.ph);ctx.scale(sc,sc);
    ctx.drawImage(starSpr,-38,-38);ctx.restore();
  }
  for(const b of balls){
    if(b.taken||b.x<cam.x-60||b.x>cam.x+VW+60)continue;
    const y=b.y0+Math.sin(tSim*1.3+b.ph)*12,sw=Math.sin(tSim*1.1+b.ph)*0.07;
    ctx.save();ctx.translate(b.x,y);ctx.rotate(sw);
    ctx.strokeStyle='rgba(255,255,255,0.55)';ctx.lineWidth=1.5;
    ctx.beginPath();ctx.moveTo(0,17);ctx.quadraticCurveTo(4*Math.sin(tSim*2+b.ph),30,0,42);ctx.stroke();
    ctx.fillStyle=b.c;ctx.beginPath();ctx.ellipse(0,0,13,16,0,0,TAU);ctx.fill();
    ctx.beginPath();ctx.moveTo(-3.5,15);ctx.lineTo(3.5,15);ctx.lineTo(0,20);ctx.closePath();ctx.fill();
    ctx.fillStyle='rgba(255,255,255,0.4)';ctx.beginPath();ctx.ellipse(-4.5,-5.5,4,5.5,-0.4,0,TAU);ctx.fill();
    ctx.restore();
  }
}

/* ============================== SANTA ============================== */
const COAT='#D8382F',COATD='#B22A24',SKIN='#F6C9A2',SACK='#A2653C',SACKD='#7E4C2B',
      BELT='#2E2A33',GOLD='#F4C24E',SKI='#E86A3C',SKID='#B84A28',BOOT='#4A3230';
function drawSki(ox,oy,col){
  ctx.strokeStyle=col;ctx.lineWidth=4.5;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(ox-24,oy);ctx.lineTo(ox+26,oy);ctx.quadraticCurveTo(ox+34,oy,ox+37,oy-7);ctx.stroke();
}
function drawSanta(){
  const gy=groundY(P.x),h=Math.max(0,gy-P.y),hk=clamp(h/220,0,1);
  const sw=lerp(64,26,hk);
  ctx.globalAlpha=lerp(0.3,0.08,hk);
  ctx.drawImage(shadowSpr,P.x-sw/2,gy-7,sw,14);ctx.globalAlpha=1;
  const bob=P.on?Math.sin(tSim*10)*0.8*(P.v/900):0;
  ctx.save();
  ctx.translate(P.x,P.y-26+bob);ctx.rotate(P.rot);ctx.translate(0,26);
  const cr=P.crouch;
  ctx.scale(1+P.sq*0.5+cr*0.12,1-P.sq-cr*0.26);
  const fur=C.fur,spd=P.v/1000,flut=Math.sin(tSim*10)*2*spd;
  // skis
  drawSki(-3,-3,SKID);drawSki(0,0,SKI);
  // boots & legs
  ctx.fillStyle=BOOT;rr(ctx,-10+cr*4,-9,13,9,3);ctx.fill();rr(ctx,4+cr*4,-9,13,9,3);ctx.fill();
  ctx.fillStyle=COATD;ctx.fillRect(-6+cr*2,-19,9,11);ctx.fillRect(7+cr*2,-19,9,11);
  // sack
  ctx.save();ctx.translate(-21,-36);
  if(P.deflated)ctx.scale(0.6,0.55);
  const jig=Math.sin(tSim*9)*1.5*spd+P.sq*4;
  ctx.fillStyle=SACK;
  ctx.beginPath();ctx.moveTo(-13,10);
  ctx.bezierCurveTo(-17,-4,-12,-13,-3,-15);
  ctx.bezierCurveTo(6,-17,13,-9,12,3);
  ctx.bezierCurveTo(11,10,4,13,-4,13);ctx.closePath();ctx.fill();
  ctx.fillStyle=SACKD;ctx.beginPath();ctx.ellipse(-1,9,11,4.5,0.1,0,Math.PI);ctx.fill();
  if(!P.deflated){
    ctx.save();ctx.translate(-2,-16+jig*0.4);
    ctx.fillStyle=GOLD;ctx.save();ctx.rotate(-0.25);ctx.fillRect(-5,-6,9,9);
    ctx.fillStyle='#E23B3B';ctx.fillRect(-1.5,-6,2.5,9);ctx.restore();
    ctx.fillStyle='#3FB8AF';ctx.save();ctx.translate(6,-2);ctx.rotate(0.3);ctx.fillRect(-3.5,-5,7,7);
    ctx.fillStyle='#FFFFFF';ctx.fillRect(-1,-5,2,7);ctx.restore();
    ctx.restore();
    ctx.strokeStyle=GOLD;ctx.lineWidth=2.5;
    ctx.beginPath();ctx.moveTo(-8,-13+jig*0.3);ctx.quadraticCurveTo(-2,-17+jig*0.3,5,-13+jig*0.3);ctx.stroke();
  }
  ctx.restore();
  // back arm
  ctx.strokeStyle=COATD;ctx.lineWidth=7;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(-8,-38);ctx.lineTo(-17,-33);ctx.stroke();
  ctx.fillStyle=COATD;ctx.beginPath();ctx.arc(-18,-32,3.6,0,TAU);ctx.fill();
  // coat
  ctx.fillStyle=COAT;
  ctx.beginPath();ctx.moveTo(-14,-18);ctx.lineTo(-20-flut,-12);ctx.lineTo(-11,-12);ctx.closePath();ctx.fill();
  rr(ctx,-13,-46,24,34,8);ctx.fill();
  ctx.fillStyle=fur;rr(ctx,-14,-18,26,7,3.5);ctx.fill();
  rr(ctx,4,-44,5,27,2.5);ctx.fill();
  ctx.fillStyle=BELT;ctx.fillRect(-13,-30,24,5);
  ctx.fillStyle=GOLD;rr(ctx,0,-31.5,7,8,1.5);ctx.fill();
  ctx.fillStyle=BELT;ctx.fillRect(2,-29.5,3,4);
  // front arm
  ctx.strokeStyle=COAT;ctx.lineWidth=7;
  ctx.beginPath();ctx.moveTo(6,-38);ctx.lineTo(17,-29);ctx.stroke();
  ctx.fillStyle=fur;ctx.beginPath();ctx.arc(15,-30.5,3.2,0,TAU);ctx.fill();
  ctx.fillStyle=COATD;ctx.beginPath();ctx.arc(18.5,-27.5,4,0,TAU);ctx.fill();
  // head
  ctx.fillStyle=SKIN;ctx.beginPath();ctx.arc(6,-52,7.2,0,TAU);ctx.fill();
  ctx.fillStyle=fur;
  ctx.beginPath();ctx.moveTo(-2,-50);
  ctx.quadraticCurveTo(-5,-38,6,-33);ctx.quadraticCurveTo(16,-37,14.5,-50);
  ctx.quadraticCurveTo(10,-46,6,-46.5);ctx.quadraticCurveTo(1,-46,-2,-50);ctx.closePath();ctx.fill();
  ctx.beginPath();ctx.ellipse(3.5,-48.5,3.4,2.1,0.25,0,TAU);ctx.fill();
  ctx.beginPath();ctx.ellipse(10.5,-48.5,3.4,2.1,-0.25,0,TAU);ctx.fill();
  ctx.fillStyle='#EFA47E';ctx.beginPath();ctx.arc(12,-51,2.8,0,TAU);ctx.fill();
  ctx.fillStyle='rgba(240,130,110,0.35)';ctx.beginPath();ctx.arc(9.5,-47.5,1.8,0,TAU);ctx.fill();
  if(state==='crashing'||state==='gameover'){
    ctx.strokeStyle='#33262B';ctx.lineWidth=1.6;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(6.6,-55.6);ctx.lineTo(9.6,-52.6);ctx.moveTo(9.6,-55.6);ctx.lineTo(6.6,-52.6);ctx.stroke();
  }else{
    ctx.fillStyle='#33262B';ctx.beginPath();ctx.arc(8.2,-54,1.35,0,TAU);ctx.fill();
  }
  ctx.strokeStyle=fur;ctx.lineWidth=2.2;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(5.8,-57.4);ctx.lineTo(10.2,-57.8);ctx.stroke();
  // hat
  const sw2=Math.sin(tSim*7)*2+spd*3;
  ctx.fillStyle=COAT;ctx.beginPath();ctx.arc(5.5,-61,8,Math.PI,0);ctx.closePath();ctx.fill();
  ctx.strokeStyle=COAT;ctx.lineWidth=6;
  ctx.beginPath();ctx.moveTo(-1,-64);ctx.quadraticCurveTo(-11,-70,-17,-64+sw2);ctx.stroke();
  ctx.fillStyle=fur;rr(ctx,-2.5,-63.5,16,5,2.5);ctx.fill();
  ctx.beginPath();ctx.arc(-18,-63+sw2,3.6,0,TAU);ctx.fill();
  ctx.restore();
}

/* ============================== PARTICLE & POPUP DRAW ============================== */
function drawParts(scr){
  for(const p of parts){
    if(!!p.scr!==scr)continue;
    const k=1-p.t/p.life;
    switch(p.type){
      case 'spray':ctx.globalAlpha=k*0.85;ctx.fillStyle='#FFFFFF';
        ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,TAU);ctx.fill();break;
      case 'puff':ctx.globalAlpha=k*0.3;ctx.fillStyle='#FFFFFF';
        ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,TAU);ctx.fill();break;
      case 'spark':ctx.globalAlpha=k*(0.6+0.4*Math.sin(p.t*30));ctx.fillStyle=p.c;
        ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,TAU);ctx.fill();break;
      case 'ring':ctx.globalAlpha=k*0.8;ctx.strokeStyle=p.c;ctx.lineWidth=2.5;
        ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,TAU);ctx.stroke();break;
      case 'gift':ctx.globalAlpha=Math.min(1,k*3);
        ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);
        ctx.fillStyle=p.c;ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size);
        ctx.fillStyle=p.c2;ctx.fillRect(-p.size*0.12,-p.size/2,p.size*0.24,p.size);
        ctx.fillRect(-p.size/2,-p.size*0.12,p.size,p.size*0.24);
        ctx.restore();break;
      case 'hat':ctx.globalAlpha=Math.min(1,k*3);
        ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);
        ctx.fillStyle=COAT;ctx.beginPath();ctx.moveTo(-9,3);ctx.quadraticCurveTo(0,-12,9,3);ctx.closePath();ctx.fill();
        ctx.fillStyle=C.fur;rr(ctx,-10,1,20,4.5,2);ctx.fill();
        ctx.beginPath();ctx.arc(9,-4,3,0,TAU);ctx.fill();
        ctx.restore();break;
      case 'shard':ctx.globalAlpha=k;ctx.fillStyle=p.c;
        ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);
        ctx.beginPath();ctx.moveTo(-p.size,p.size);ctx.lineTo(p.size,0);ctx.lineTo(-p.size*0.4,-p.size);ctx.closePath();ctx.fill();
        ctx.restore();break;
      case 'streak':ctx.globalAlpha=k*0.3;ctx.strokeStyle='#FFFFFF';ctx.lineWidth=1.6;
        ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(p.x+p.size,p.y);ctx.stroke();break;
      case 'shoot':ctx.globalAlpha=k*0.9;ctx.strokeStyle='#FFFFFF';ctx.lineWidth=2;ctx.lineCap='round';
        ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(p.x+p.size,p.y-p.size*0.37);ctx.stroke();break;
    }
  }
  ctx.globalAlpha=1;
}
function drawPops(scr){
  ctx.textAlign='center';ctx.lineJoin='round';
  let si=0;
  for(const p of pops){
    if(p.scr!==scr)continue;
    const inK=clamp(p.t*3,0,1),outK=clamp((p.life-p.t)/0.3,0,1);
    const sc=easeOutBack(inK);
    let x=p.x,y=p.y;
    if(scr){x=VW/2;y=VH*0.24+si*44;si++;}
    else y=p.y-p.t*45;
    ctx.save();ctx.translate(x,y);ctx.scale(sc,sc);
    ctx.globalAlpha=outK;
    ctx.font='900 '+p.size+'px "Segoe UI",system-ui,sans-serif';
    ctx.strokeStyle='rgba(15,25,55,0.85)';ctx.lineWidth=p.size*0.22;
    ctx.strokeText(p.text,0,0);
    ctx.fillStyle=p.c;ctx.fillText(p.text,0,0);
    ctx.restore();
  }
  ctx.globalAlpha=1;
}

/* ============================== SNOW & FOREGROUND ============================== */
const flakes=[];
for(let i=0;i<(reduced?60:110);i++)
  flakes.push({x:Math.random(),y:Math.random(),z:rand(0.35,1),ph:rand(TAU)});
function updateSnow(dt){
  const wind=state==='playing'||state==='crashing'?-P.v*0.00012:-0.02;
  for(const f of flakes){
    f.y+=(0.05+0.13*f.z)*dt;
    f.x+=(wind*f.z+Math.sin(tGlobal*1.2+f.ph)*0.012)*dt;
    if(f.y>1.02){f.y=-0.02;f.x=Math.random();}
    if(f.x<-0.02)f.x+=1.04;if(f.x>1.02)f.x-=1.04;
  }
}
function drawSnow(){
  ctx.fillStyle='#FFFFFF';
  for(const f of flakes){
    ctx.globalAlpha=0.35+0.5*f.z;
    ctx.beginPath();ctx.arc(f.x*VW,f.y*VH,0.9+2.3*f.z,0,TAU);ctx.fill();
  }
  ctx.globalAlpha=1;
}
function drawFg(){
  const pf=1.22,ox=cam.x*pf,w=700;
  const i0=Math.floor(ox/w)-1,n=Math.ceil(VW/w)+3;
  ctx.globalAlpha=0.88;
  for(let i=i0;i<i0+n;i++){
    if(hash(i*9.1+31)<0.78)continue;
    const x=i*w-ox+hash(i*4.7+13)*300,h=120+hash(i*6.3+7)*90;
    drawFir(x,VH+14,h,C.fg,null);
  }
  ctx.globalAlpha=1;
}

/* ============================== RENDER ============================== */
function render(){
  updatePalette(meters);
  ctx.setTransform(DPR*S,0,0,DPR*S,0,0);
  const dev=clamp((cam.y+VH*0.56)-groundY(cam.x+VW*0.3),-240,240);
  drawSky(dev);
  const shx=Math.sin(tGlobal*57)*shakeA,shy=Math.cos(tGlobal*47)*shakeA*0.7;
  drawRidge(0.10,260,90,210,C.far,C.farCap,VH*0.60-dev*0.05+shy*0.2,3);
  drawRidge(0.22,200,60,140,C.mid,C.midCap,VH*0.63-dev*0.10+shy*0.4,17);
  drawHills(dev);
  ctx.save();
  ctx.translate(-cam.x+shx,-cam.y+shy);
  drawTerrain();
  drawTrack();
  drawGarland();
  drawMarkers();
  drawEntities();
  drawSanta();
  drawParts(false);
  drawPops(false);
  ctx.restore();
  drawFg();
  drawSnow();
  drawParts(true);
  drawPops(true);
  const vg=ctx.createRadialGradient(VW/2,VH*0.45,Math.min(VW,VH)*0.45,VW/2,VH/2,Math.max(VW,VH)*0.78);
  vg.addColorStop(0,'rgba(8,12,30,0)');
  vg.addColorStop(1,'rgba(8,12,30,'+(0.22+C.night*0.15)+')');
  ctx.fillStyle=vg;ctx.fillRect(0,0,VW,VH);
  if(flash>0.01){ctx.fillStyle='rgba(226,59,59,'+flash*0.3+')';ctx.fillRect(0,0,VW,VH);}
}

/* ============================== SIM & AI ============================== */
function aiStep(dt){
  aiT-=dt;
  if(P.on&&aiT<0){aiT=rand(2.4,4.4);P.jbuf=0.1;aiSpin=Math.random()<0.5;}
  if(!P.on&&aiSpin&&P.air>0.15){P.om=Math.max(-13,P.om-6.8);P.spinT=0.25;aiSpin=false;}
}
function simStep(dt){
  tSim+=dt;
  if(state==='playing'){
    stepPlayer(dt,crouchInput());
    if(state==='playing'){
      meters=Math.max(meters,P.x/METER);
      spawnAhead();collisions();
    }
    cTimer-=dt;if(cTimer<0)cStreak=0;
  }else if(state==='menu'){
    aiStep(dt);stepPlayer(dt,false);
  }else if(state==='crashing'||state==='gameover'){
    tumble(dt);
  }
  cull();
  updateParts(dt);updatePops(dt);
  cam.x+=(P.x-VW*0.30-cam.x)*(1-Math.exp(-8*dt));
  const ty=P.y-VH*0.56+clamp(P.vy*0.10,-40,70);
  cam.y+=(ty-cam.y)*(1-Math.exp(-3.2*dt));
}

/* ============================== DOM / STATES ============================== */
const els={hud:$('hud'),speedo:$('speedo'),hDist:$('hDist'),hStars:$('hStars'),hScore:$('hScore'),kmh:$('kmh'),
  bestVal:$('bestVal'),menuBest:$('menuBest'),btnPause:$('btnPause'),btnSound:$('btnSound'),
  ovMenu:$('ovMenu'),ovOver:$('ovOver'),ovPause:$('ovPause'),
  goCause:$('goCause'),goDist:$('goDist'),goBonus:$('goBonus'),goBonusPts:$('goBonusPts'),
  goTrick:$('goTrick'),goTrickPts:$('goTrickPts'),goTotal:$('goTotal'),goRecord:$('goRecord')};
const hudCache={d:-1,s:-1,sc:-1,k:-1};
function updateHUD(){
  if(state!=='playing'&&state!=='crashing')return;
  const d=Math.floor(meters),sc=d+bonusPts+trickPts,k=Math.round(P.v/METER*3.6);
  if(d!==hudCache.d){hudCache.d=d;els.hDist.textContent=fmt(d);}
  if(starCount!==hudCache.s){hudCache.s=starCount;els.hStars.textContent=starCount;}
  if(sc!==hudCache.sc){hudCache.sc=sc;els.hScore.textContent=fmt(sc);}
  if(k!==hudCache.k){hudCache.k=k;els.kmh.textContent=k;}
}
function setState(s){
  state=s;
  els.ovMenu.classList.toggle('hidden',s!=='menu');
  els.ovOver.classList.toggle('hidden',s!=='gameover');
  els.ovPause.classList.toggle('hidden',s!=='paused');
  els.hud.classList.toggle('hidden',!(s==='playing'||s==='crashing'||s==='paused'));
  els.speedo.classList.toggle('hidden',!(s==='playing'||s==='crashing'||s==='paused'));
  els.btnPause.classList.toggle('hidden',s!=='playing');
}
function resetRun(){
  P.x=0;P.y=groundY(0);P.v=DIFF.min;P.vx=P.v;P.vy=0;P.rot=Math.atan(slopeAt(0));
  P.om=0;P.on=true;P.crouch=0;P.air=0;P.airRot=0;P.flips=0;P.sq=0;P.sqv=0;
  P.coyote=0;P.jbuf=0;P.spinT=0;P.breath=1;P.spray=0;P.deflated=false;
  obs.length=0;stars.length=0;balls.length=0;parts.length=0;pops.length=0;track.length=0;
  meters=0;starCount=0;bonusPts=0;trickPts=0;trickCount=0;cStreak=0;cTimer=0;
  spawnX=820;shakeA=0;flash=0;crashT=0;goShown=false;timeScale=1;acc=0;
  aiT=2;aiSpin=false;pHeld=false;pointerCrouch=false;keys.down=false;
  cam.x=P.x-VW*0.30;cam.y=P.y-VH*0.56;
  hudCache.d=hudCache.s=hudCache.sc=hudCache.k=-1;
}
function startGame(){
  if(document.activeElement&&document.activeElement.blur)document.activeElement.blur();
  reseed();resetRun();setState('playing');
  popupScreen('Поехали!','#FFFFFF',34);sfx.ui();
}
function toMenu(){reseed();resetRun();setState('menu');sfx.ui();}
function showGameOver(){
  const f=finalStats,total=f.m+f.bp+f.tp;
  els.goCause.textContent=causeText;
  els.goDist.textContent=fmt(f.m)+' м';
  els.goBonus.textContent=f.stars;els.goBonusPts.textContent='+'+fmt(f.bp);
  els.goTrick.textContent=f.tc;els.goTrickPts.textContent='+'+fmt(f.tp);
  els.goTotal.textContent=fmt(total);
  const rec=total>best;
  if(rec){best=total;save('nm_best',best);els.bestVal.textContent=fmt(best);els.menuBest.textContent=fmt(best);}
  els.goRecord.classList.toggle('hidden',!rec);
  setState('gameover');
}
function togglePause(){
  if(state==='playing'){setState('paused');sfx.ui();}
  else if(state==='paused')resume();
}
function resume(){if(state==='paused'){setState('playing');sfx.ui();}}

$('btnStart').addEventListener('click',e=>{e.stopPropagation();ensureAudio();startGame();});
els.ovMenu.addEventListener('click',e=>{if(e.target.closest('button'))return;ensureAudio();startGame();});
$('btnRetry').addEventListener('click',e=>{e.stopPropagation();ensureAudio();startGame();});
$('btnToMenu').addEventListener('click',e=>{e.stopPropagation();toMenu();});
$('btnResume').addEventListener('click',e=>{e.stopPropagation();resume();});
$('btnPauseRetry').addEventListener('click',e=>{e.stopPropagation();startGame();});
$('btnPauseMenu').addEventListener('click',e=>{e.stopPropagation();toMenu();});
els.btnPause.addEventListener('click',e=>{e.stopPropagation();ensureAudio();togglePause();});
els.btnSound.addEventListener('click',e=>{e.stopPropagation();ensureAudio();toggleMute();});
document.querySelectorAll('#diffRow .pill').forEach(b=>{
  b.addEventListener('click',e=>{
    e.stopPropagation();ensureAudio();
    diffIdx=clamp(parseInt(b.dataset.d,10)||0,0,2);DIFF=DIFFS[diffIdx];save('nm_diff',diffIdx);
    document.querySelectorAll('#diffRow .pill').forEach(p=>p.classList.toggle('sel',p===b));
    sfx.ui();
  });
});

/* ============================== MAIN LOOP ============================== */
let last=performance.now();
function frame(now){
  requestAnimationFrame(frame);
  let dt=(now-last)/1000;last=now;
  if(dt>0.1)dt=0.1;
  tGlobal+=dt;
  updateHold(dt);
  shakeA*=Math.exp(-6*dt);
  flash*=Math.exp(-5*dt);
  let tsTarget=1;
  if(state==='crashing'){
    crashT+=dt;
    tsTarget=crashT<0.5?0.28:lerp(0.28,0.9,clamp((crashT-0.5)/0.6,0,1));
    if(crashT>1.15&&!goShown){goShown=true;showGameOver();}
  }else if(state==='gameover')tsTarget=0.5;
  timeScale+=(tsTarget-timeScale)*Math.min(1,dt*6);
  if(state==='playing'||state==='menu'||state==='crashing'||state==='gameover'){
    acc+=dt*timeScale;let n=0;
    while(acc>=SIM_DT&&n<8){simStep(SIM_DT);acc-=SIM_DT;n++;}
    if(n===8)acc=0;
    updateSnow(dt*timeScale);
  }
  musicTick();
  render();
  updateHUD();
}

/* ============================== INIT ============================== */
els.bestVal.textContent=fmt(best);
els.menuBest.textContent=fmt(best);
els.btnSound.classList.toggle('muted',AU.muted);
document.querySelectorAll('#diffRow .pill').forEach(p=>p.classList.toggle('sel',parseInt(p.dataset.d,10)===diffIdx));
reseed();resetRun();setState('menu');
requestAnimationFrame(frame);
})();
</script>
